amends "templates/TgDownloaderConfig.pkl"

local botToken     = read("prop:botToken")
local adminUser    = read("prop:adminUsername")
local botName_     = read("prop:botName")
local ytdlpPath    = read("prop:ytdlpPath")

telegramConfiguration {
    tgBotApiKey = botToken
    botName = botName_
    updateTimeout = 2
    updateOffset = 0
    updateLimit = 2
}

authConfiguration {
    admininstrators {
        new {
            userName = adminUser
        }
    }
}

commandConfiguration {
    commands {
        ["activateGroup"] {
            command = "/a"
            description = "Activate this group for downloading"
            accessLevel = "user"
        }
        ["deactivateGroup"] {
            command = "/d"
            description = "Deactivate this group"
            accessLevel = "user"
        }
        ["getBotCommands"] {
            command = "/i"
            description = "Get available bot commands"
            accessLevel = "user"
        }
        ["loadResource"] {
            command = "/l"
            description = "Load resource for downloading"
            accessLevel = "user"
        }
        ["start"] {
            command = "/start"
            description = "Start the bot"
            accessLevel = "user"
        }
        ["getServerLoad"] {
            command = "/l"
            description = "Get server load information"
            accessLevel = "admin"
        }
        ["getAllGroups"] {
            command = "/a"
            description = "Get all groups"
            accessLevel = "admin"
        }
        ["deleteGroup"] {
            command = "/d"
            description = "Delete a group"
            accessLevel = "admin"
        }
    }

    supportedLinks {
        new {
            name = "Instagram Reels"
            pattern = "^https://(?:www\\.)?instagram\\.com/(?:reel|p)/[A-Za-z0-9_-]+/?(?:\\?.*)?$"
            example = "EXAMPLE"
            strategies {
                new { name = "best"; format = "b" }
                new { name = "best 720p"; format = "best[height<=720]" }
                new { name = "worst"; format = "worst" }
            }
            extractorArgs {}
        }
        new {
            name = "TikTok"
            pattern = "^https://(?:www\\.)?vt\\.tiktok\\.com/[A-Za-z0-9]+/?(?:\\?.*)?$"
            example = "EXAMPLE"
            strategies {
                new { name = "best"; format = "b" }
                new { name = "best 720p"; format = "best[height<=720]" }
                new { name = "worst"; format = "worst" }
            }
            extractorArgs {}
        }
        new {
            name = "TikTok Full"
            pattern = "^https://(?:www\\.)?tiktok\\.com/@[A-Za-z0-9_.]+/(?:video|photo)/[0-9]+/?(?:\\?.*)?$"
            example = "EXAMPLE"
            strategies {
                new { name = "best"; format = "b" }
                new { name = "worst"; format = "worst" }
            }
            extractorArgs {}
        }
        new {
            name = "YouTube Shorts"
            pattern = "^https://(?:www\\.)?youtube\\.com/shorts/[A-Za-z0-9_-]+/?(?:\\?.*)?$"
            example = "EXAMPLE"
            strategies {
                new { name = "best"; format = "b" }
                new { name = "best 720p"; format = "best[height<=720]" }
                new { name = "worst"; format = "worst" }
            }
            extractorArgs { "youtube:player_client=web" }
        }
        new {
            name = "Twitter/X"
            pattern = "^https://(?:www\\.)?(vxtwitter|x|twitter)\\.com/[A-Za-z0-9_]+/status/[0-9]+(?:\\?.*)?$"
            example = "EXAMPLE"
            strategies {
                new { name = "best"; format = "b" }
                new { name = "best 720p"; format = "best[height<=720]" }
                new { name = "worst"; format = "worst" }
            }
            extractorArgs {}
        }
        // Any new formats...
    }
}

commonDownloaderConfiguration {
    ytdlpExecutablePath = ytdlpPath

    // Force IPv4 to avoid IPv6 connectivity issues
    forceIPv4 = true

    // Sleep intervals to avoid rate limiting
    sleepInterval = 1.0
    maxSleepInterval = 3.0

    // Additional extractor arguments
    extractorArgs {}

    // Custom HTTP headers
    customHeaders {}
}

videoDownloaderConfiguration {
    outputFormat = "mp4"
    maxFileSizeMB = 50
    downloadTimeoutSeconds = 300
    uploadTimeoutSeconds = 300
}

workerConfiguration {
    workerCount = 2
    taskPollingInterval = 1
    maxRetries = 2
}

poTokenConfiguration {
    providerUrl = "http://127.0.0.1:4416"
    healthCheckIntervalSeconds = 900
}

debug = false
