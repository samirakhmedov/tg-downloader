# =============================================================================
# PO Token Server (bgutil-ytdlp-pot-provider)
# Provides YouTube Proof-of-Origin tokens for yt-dlp
# =============================================================================
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN git clone --single-branch --branch 1.3.1 \
        https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git /tmp/pot \
    && mv /tmp/pot/server /app/server \
    && cd /app/server && npm ci && npx tsc \
    && rm -rf /tmp/pot

WORKDIR /app/server

EXPOSE 4416

CMD ["node", "build/main.js"]
