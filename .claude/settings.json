{
    "env": {
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": 1,
        "DISABLE_TELEMETRY": 1,
        "DISABLE_ERROR_REPORTING": 1
    },
    "cleanupPeriodDays": 1,
    "permissions": {
        "disableBypassPermissionsMode": "disable",
        "deny": [
            "Read(**/.env)",
            "Bash(sudo:*)",
            "Bash(su:*)",
            "Bash(curl:*)",
            "Bash(wget:*)",
            "Bash(ssh:*)",
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./secrets/**)",
            "Read(**/*.pem)",
            "Read(**/*id_rsa*)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.kube/**)",
            "Read(~/.gnupg/**)",
            "Bash(chmod:*)",
            "Bash(chown:*)",
            "Bash(dd:*)",
            "Bash(mkfs:*)",
            "Bash(mount:*)",
            "Bash(umount:*)",
            "Bash(shutdown:*)",
            "Bash(reboot:*)",
            "Bash(systemctl:*)",
            "Bash(kill -9:*)",
            "Bash(pkill:*)",
            "Bash(killall:*)",
            "Bash(git push:*)",
            "Bash(git push --force:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean -fd:*)",
            "Bash(ssh:*)",
            "Bash(scp:*)",
            "Bash(rsync:*)",
            "Bash(docker run:*)",
            "Bash(docker push:*)",
            "Bash(docker login:*)",
            "Bash(docker system prune:*)",
            "Bash(docker rm:*)",
            "Bash(docker rmi:*)",
            "Bash(docker volume rm:*)",
            "Bash(docker network rm:*)",
            "Bash(terraform:*)",
            "Bash(kubectl:*)",
            "Bash(helm:*)",
            "Bash(aws:*)",
            "Bash(gcloud:*)",
            "Bash(uv publish:*)",
            "Bash(brew:*)"
        ],
        "allow": [
            "Bash(find:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(ls:*)",
            "Bash(sort:*)",
            "Bash(echo:*)",
            "Bash(grep:*)",
            "Bash(openspec:*)",
            "Bash(fvm:*)",
            "Read",
            "WebFetch",
            "WebSearch"
        ],
        "ask": [
            "Bash(rm:*)"
        ],
        "defaultMode": "acceptEdits"
    },
    "includeCoAuthoredBy": false,
    "gitAttribution": false,
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "model": "opus",
    "effortLevel": "high",
    "autoUpdatesChannel": "latest"
}